# Copy this file to .env and fill in the values (never commit .env).

# PostgreSQL connection (default: postgres:1234@localhost:5432/visionguard).
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_DB_PASSWORD@localhost:5432/visionguard

# Secret used to sign login tokens; use a long random string.
VISIONGUARD_SECRET_KEY=change-me

# Gmail used to send password-reset codes and violation alerts
# (Google Account -> Security -> App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.address@gmail.com
SMTP_PASSWORD=your-16-letter-app-password
SMTP_FROM_NAME=VisionGuard

# Where links in emails point (the React app).
FRONTEND_URL=http://localhost:3000
